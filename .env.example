# Development defaults to deterministic fixtures and browser-backed persistence.
NEXT_PUBLIC_DATA_MODE=mock

# Required when NEXT_PUBLIC_DATA_MODE=live.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Catalog credentials are server-only. Missing providers degrade independently.
TMDB_API_READ_TOKEN=
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=
GOOGLE_BOOKS_API_KEY=

# Deployment URLs are configured in Supabase/Vercel, not hard-coded in Mosaic.
# Example production callback: https://mosaic.example.com/auth/callback
