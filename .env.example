# Development defaults to deterministic fixtures and browser-backed persistence.
NEXT_PUBLIC_DATA_MODE=mock

# Required when NEXT_PUBLIC_DATA_MODE=live.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Production-only canonical public origin for OAuth redirects. Leave unset locally.
NEXT_PUBLIC_SITE_URL=

# Catalog credentials are server-only. Missing providers degrade independently.
TMDB_API_READ_TOKEN=
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=
GOOGLE_BOOKS_API_KEY=

# Mosaic AI (server-only). Off unless MOSAIC_AI_ENABLED=true. Requests use OpenRouter with
# zero-data-retention, Novita-only, zero-price routing; only reviewed model/provider pairs start.
# MOSAIC_AI_ALLOWED_USERS is a comma-separated list of user IDs (private beta); "*" admits every signed-in user.
OPENROUTER_API_KEY=
MOSAIC_AI_ENABLED=false
MOSAIC_AI_MODEL=apodex/apodex-1.1-mini:free
MOSAIC_AI_PROVIDER=novita
MOSAIC_AI_ALLOWED_USERS=
# Public, build-time: shows the Ask entry points and /ask page in live builds (dark launch while unset).
NEXT_PUBLIC_MOSAIC_AI_UI=false

# Deployment URLs are configured in Supabase/Vercel, not hard-coded in Mosaic.
# Example production callback: https://mosaic.example.com/auth/callback
